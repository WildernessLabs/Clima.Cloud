@using System.Text.Json
@using ClimaCloud.Shared.Messages
@inject IJSRuntime JS

<div id="@($"echart-{MeasurementProperty}")" style="width: 100%; height: 380px;"></div>

@code {
    [Parameter]
    public List<ClientEventMessage> DataItems { get; set; }

    [Parameter]
    public string MeasurementProperty { get; set; }
    
    [Parameter]
    public string Unit { get; set; }
    
    private bool IsImportComplete { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        await RenderChart();
    }

    private async Task RenderChart()
    {
        var data = DataItems.Select(item => new
        {
            x = item.ReceivedAt,
            y = item.Measurements.ContainsKey(MeasurementProperty) ? item.Measurements[MeasurementProperty] : 0
        }).ToList();

        var json = JsonSerializer.Serialize(data);

        IJSObjectReference? module = null;
        if (!IsImportComplete)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", $"./js/config/echarts-theme.js?v={DateTime.Now.Ticks}");
            module = await JS.InvokeAsync<IJSObjectReference>("import", $"./js/echarts-basiclinechart.js?v={DateTime.Now.Ticks}");
            IsImportComplete = true;
        }
        
        if(module != null) await module.InvokeVoidAsync("renderEChart", $"echart-{MeasurementProperty}", json, MeasurementProperty, Unit);
    }
}