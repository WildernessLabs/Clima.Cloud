@page "/"
@using System.Net.Http.Json
@using ClimaCloud.Shared.Messages

@inject IJSRuntime JS
@inject HttpClient Http
@inject IConfiguration Configuration
@implements IDisposable

<div class="dashboard-container">
    <div id="globe-container" class="globe-container @(IsGlobeCollapsed ? "globe-collapsed" : "globe-full-width")" style="width: 100%; height: 100vh;">
        @if (IsLoading)
        {
            <div class="spinner-border text-primary" role="status" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
                <span class="sr-only">Loading...</span>
            </div>
        }
    </div>

    <div id="charts-container" class="charts-container">
        <div>
            <img @onclick="CollapseCharts" class="reverse collapse-charts" src="asset/nav-collapse.svg">
        </div>
        <div></div>

        <h2>Clima Statistics</h2>
        <div></div>
        @if (IsGlobeCollapsed)
        {
            <div class="chart-item">
                <BasicLineChart DataItems="DeviceDataItems" MeasurementProperty="Temperature" Unit="Celsius"/>
            </div>
            <div class="chart-item">
                <BasicLineChart DataItems="DeviceDataItems" MeasurementProperty="Humidity" Unit="Percent"/>
            </div>
            <div class="chart-item">
                <BasicLineChart DataItems="DeviceDataItems" MeasurementProperty="Pressure" Unit="Atmospheres"/>
            </div>
            <div class="chart-item">
                <BasicLineChart DataItems="DeviceDataItems" MeasurementProperty="Co2Level" Unit="Parts per Million"/>
            </div>
            <div class="ids">
                <div>Device Id: @(DeviceId)</div>
            </div>
        }
    </div>
</div>

@code {
    private IJSObjectReference? _module;
    private PeriodicTimer? _timer;
    private bool IsLoading { get; set; } = false;
    private bool IsGlobeCollapsed { get; set; } = false;
    private List<ClientEventMessage>? DeviceDataItems;
    private string? DeviceId;
    private string? OrgId;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        var data = await FetchData();
        IsLoading = false;

        if (data != null)
        {
            data.Data = data.Data ?? new();
            await InitializeChart(data.Data);
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            _ = TimerLoop();
        }

        StateHasChanged();
    }

    private async Task<ResponseMessage<List<ClientEventMessage>>?> FetchData()
    {
        try
        {
            return await Http.GetFromJsonAsync<ResponseMessage<List<ClientEventMessage>>>($"{Configuration["ServerApi:BaseAddress"]}/events/GetAllEvents");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error fetching data: {ex.Message}");
            return null;
        }
    }

    private async Task<ResponseMessage<List<ClientEventMessage>>?> FetchDeviceData(string orgId, string deviceId)
    {
        try
        {
            return await Http.GetFromJsonAsync<ResponseMessage<List<ClientEventMessage>>>($"{Configuration["ServerApi:BaseAddress"]}/events/GetAllEventsByDevice?orgId={orgId}&deviceId={deviceId}");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error fetching data: {ex.Message}");
            return null;
        }
    }

    private async Task TimerLoop()
    {
        while (await _timer!.WaitForNextTickAsync())
        {
            var data = await FetchData();
            if (data?.Data != null)
            {
                await UpdateChartData(data.Data);
            }
        }
    }
    
    private async Task InitializeChart(List<ClientEventMessage> data)
    {
        _module = await JS.InvokeAsync<IJSObjectReference>("import", $"./js/echarts-globe.js?v={DateTime.Now.Ticks}");
        if (_module != null)
        {
            await _module.InvokeVoidAsync("disposeEChartsGlobe");
            await _module.InvokeVoidAsync("initEChartsGlobe", DotNetObjectReference.Create(this), data);

            await Task.Delay(1000);
        }
    }

    private async Task UpdateChartData(List<ClientEventMessage> data)
    {
        if (_module != null)
        {
            if (!string.IsNullOrWhiteSpace(OrgId) && !string.IsNullOrWhiteSpace(DeviceId))
            {
                var deviceData = await FetchDeviceData(OrgId, DeviceId);
                DeviceDataItems = deviceData?.Data;
            }

            await _module.InvokeVoidAsync("updateEChartsData", data);
            StateHasChanged();
        }
    }
    
    private async Task CollapseCharts()
    {
        if (IsGlobeCollapsed) await _module.InvokeVoidAsync("collapseCharts");
        IsGlobeCollapsed = false;
    }

    [JSInvokable]
    public async Task OnChartClick(string orgId, string deviceId, double longitude, double latitude)
    {
        if (_module != null)
        {
            var data = await FetchDeviceData(orgId, deviceId);

            if (!IsGlobeCollapsed) await _module.InvokeVoidAsync("shrinkGlobe", 50);
            IsGlobeCollapsed = true;

            OrgId = orgId;
            DeviceId = deviceId;

            DeviceDataItems = data?.Data;

            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _module?.DisposeAsync();
        JS.InvokeVoidAsync("disposeEChartsGlobe");
    }

}